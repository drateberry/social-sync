# Copy to `.env.local` for `npm run dev`.
# For production, set these as Worker secrets on the dashboard worker
# (see step 6 of the README).

WORKER_URL="http://127.0.0.1:8787"

# Plaintext admin password. The dashboard sends it to the API worker as
# the `x-admin-token` header; the worker compares its sha256 against
# ADMIN_PASSWORD_HASH. Skip this if you're fronting the API worker with
# Cloudflare Access instead.
ADMIN_TOKEN=""
